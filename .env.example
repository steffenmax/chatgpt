# ---------------------------------------------------------------------------
# imessage-agent configuration. Copy to .env and edit. Never commit .env.
# Every value here is read once at startup. Nothing is written back to disk.
# ---------------------------------------------------------------------------

# ----- Identity & behaviour -------------------------------------------------
# Name the bot answers to. Matched as a whole word, case-insensitive, "@" optional.
BOT_NAME=Coco

# Comma-separated chat GUIDs the bot is allowed to respond in. Anything else is
# ignored (and logged by GUID only, so you can add it). Find GUIDs with:
#   uv run imessage-agent chats
ALLOWED_CHAT_GUIDS="iMessage;+;chat123456789012345678,iMessage;+;chat987654321098765432"

# Rolling context per chat, kept in RAM only (never on disk).
CONTEXT_MAX_MESSAGES=30
# Context is wiped after this many seconds without activity in that chat
# (default 6 hours), and always on restart.
CONTEXT_TTL_SECONDS=21600
# How often the idle sweeper runs.
CONTEXT_SWEEP_SECONDS=60

# Optional: map phone numbers / emails to names so replies can address people.
# Without this the bot asks BlueBubbles' Contacts API (local) and falls back to
# the raw address. Format: address=Name,address=Name
SENDER_NAMES="+15551234567=Alex,friend@example.com=Sam"

# A message that ends in "?" and gets no reply from anyone for this many seconds is
# treated as addressed to the bot. 0 = off (the bot only answers to its name/commands).
QUIET_QUESTION_SECONDS=0

# Occasional short text reactions ("lmaoo", "💀", "wait what") to ordinary messages,
# decided by the local model. Chance per message (0-1) and a per-chat cooldown.
# Real iMessage tapbacks would need the BlueBubbles Private API; these are plain texts.
REACTION_CHANCE=0
REACTION_COOLDOWN_SECONDS=300

# Per-chat notes about the people and the group, kept by the local model as markdown
# files (one per chat) you can read and edit. THIS WRITES MESSAGE-DERIVED CONTENT TO
# DISK (0600 files, 0700 dir, on this Mac only). Empty = off. Refreshed every N stored
# messages, capped at MEMORY_MAX_CHARS, and injected into the bot's prompt.
MEMORY_DIR=
# /remind support. Pending reminders live in this JSON file (0600) so they survive
# restarts; it holds the reminder text. Empty = off.
REMINDERS_FILE=
MEMORY_UPDATE_EVERY=15
MEMORY_MAX_CHARS=3000

# Optional: override the system prompt. {bot_name} is substituted.
# BOT_PERSONA=You are {bot_name}, ...

# ----- Webhook server --------------------------------------------------------
# Must stay on loopback. The app refuses to start on any other address.
HOST=127.0.0.1
PORT=8765
WEBHOOK_PATH=/webhook
# Shared secret BlueBubbles includes in the webhook URL (?secret=...).
# Required, >= 16 chars. Generate one:  openssl rand -hex 24
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ----- BlueBubbles Server (local) --------------------------------------------
BLUEBUBBLES_URL=http://127.0.0.1:1234
# The password you set in BlueBubbles Server > Settings > API & Webhooks.
BLUEBUBBLES_PASSWORD=change-me
# apple-script works on every setup. private-api needs SIP disabled + Private API
# enabled in BlueBubbles (faster, supports more features). Keep apple-script unless
# you know you have the Private API working.
BLUEBUBBLES_SEND_METHOD=apple-script
BLUEBUBBLES_TIMEOUT_SECONDS=30

# ----- Ollama (local LLM, default text backend) ------------------------------
OLLAMA_URL=http://127.0.0.1:11434
# Pick by RAM (scripts/doctor.sh prints a recommendation for this Mac):
#   8 GB  -> llama3.2:3b        (or qwen2.5:3b)
#   16 GB -> llama3.1:8b        (default; qwen2.5:7b also good)
#   24 GB -> qwen2.5:14b
#   32 GB+-> gemma3:27b or qwen2.5:32b
# Pull first:  ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.7
# Max tokens per reply. Replies are meant to be short.
OLLAMA_MAX_TOKENS=300
OLLAMA_TIMEOUT_SECONDS=120
# How long Ollama keeps the model loaded after a reply (saves reload time).
OLLAMA_KEEP_ALIVE=30m
# Context window in tokens. ~40 tokens per chat message: 30 messages fit in 4096,
# 100 messages need ~8192. Bigger costs RAM (roughly +0.5 GB per 4096 on an 8B model).
OLLAMA_NUM_CTX=8192
# Local vision model for photos people send (ollama pull gemma3:4b). The photo is
# captioned on this Mac and the caption goes into chat context; the bot can then
# talk about it. Loaded on demand, unloaded after VISION_KEEP_ALIVE. Empty = off.
VISION_MODEL=
VISION_MAX_WIDTH=1024
VISION_KEEP_ALIVE=2m
# On 16 GB Macs, unload the LLM before each image job so FLUX has the RAM.
UNLOAD_LLM_BEFORE_IMAGE=false

# ----- Image generation (mflux, ALWAYS local, never cloud) -------------------
IMAGE_ENABLED=true
# mflux = FLUX locally on this Mac (default, slow, private). openai = OpenAI's image
# API (10-20 s, better quality, EVERY /image PROMPT LEAVES THE MAC, pay per image).
IMAGE_BACKEND=mflux
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
# low | medium | high | auto. Price scales with quality and size.
OPENAI_IMAGE_QUALITY=medium
OPENAI_TIMEOUT_SECONDS=120
# Path or name of the mflux CLI. `uv tool install mflux` puts it in ~/.local/bin.
MFLUX_COMMAND=mflux-generate
# schnell = fast (2-4 steps). dev = better quality, ~20 steps, much slower, gated
# on Hugging Face. You can also give a path to a pre-quantized model saved with
# `mflux-save` (recommended; avoids re-quantizing on every run).
MFLUX_MODEL=schnell
MFLUX_STEPS=4
# 8 = good quality, ~12 GB RAM for schnell. 4 = ~7 GB, slightly worse. Empty = full precision (~34 GB).
MFLUX_QUANTIZE=8
MFLUX_WIDTH=768
MFLUX_HEIGHT=768
# Extra flags passed verbatim, e.g. "--low-ram --mlx-cache-limit-gb 2"
MFLUX_EXTRA_ARGS=
IMAGE_TIMEOUT_SECONDS=600
IMAGE_PROMPT_MAX_CHARS=600

# ----- Optional cloud TEXT mode (OFF by default) -----------------------------
# When true, the triggering message and the rolling context for that chat are
# sent to the Anthropic API for the text reply. Images always stay local.
# A loud warning is printed at startup when this is on.
# Requires: uv sync --extra cloud
CLOUD_LLM_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=400
ANTHROPIC_TIMEOUT_SECONDS=60

# ----- Optional cloud FACT LOOKUPS (OFF by default) --------------------------
# Lighter than cloud text mode: replies stay local EXCEPT when the local model judges
# that the question needs outside/current information (scores, news, schedules,
# prices...) or someone uses /ask. Those mentions send the triggering message and the
# rolling context to the Anthropic API, which answers with web search. Needs
# ANTHROPIC_API_KEY and: uv sync --extra cloud
CLOUD_FACTS_ENABLED=false
# Max web searches per answer (0 = no searching, just the cloud model's knowledge).
CLOUD_FACTS_MAX_SEARCHES=3

# ----- Optional /task agent (OFF by default) -----------------------------------
# /task <job> runs Claude (Agent SDK, bundled Claude Code) with web search, web fetch
# and a sandbox folder: no shell, no MCP servers, none of your Claude Code settings,
# file access fenced to TASK_DIR by a hook, its own config dir, the API key (not your
# login). Only from the chat GUIDs below (e.g. your DM with the bot). The request and
# up to TASK_CONTEXT_MESSAGES recent messages go to Anthropic; pages are fetched from
# this Mac. Each task is capped by turns, dollars and time.
TASK_ENABLED=false
TASK_CHAT_GUIDS=
# Only these senders may start tasks and answer their questions (empty = anyone in
# the task chats). Use the address iMessage reports, e.g. +15551234567.
TASK_OWNER_ADDRESSES=
TASK_DIR=
TASK_MODEL=
TASK_MAX_TURNS=25
TASK_MAX_BUDGET_USD=1.00
TASK_TIMEOUT_SECONDS=600
TASK_CONTEXT_MESSAGES=15
# Read-only headless browser for JavaScript-heavy sites (run: uv run playwright install
# chromium). Fresh private context per task; can open pages and follow links only (no
# typing, forms, logins, downloads); local and private network addresses are blocked.
TASK_BROWSER=false
# The agent may ask the requester up to N short questions in the chat ("quick q: ...").
# It is never allowed to ask for passwords, logins, codes or payment details.
TASK_MAX_QUESTIONS=2
TASK_ASK_TIMEOUT_SECONDS=240

# ----- Daily culture brief (OFF by default) ------------------------------------
# Every morning at BRIEF_TIME the task agent web-searches what people are joking about
# (BRIEF_TOPICS; default: NY sports, NFL/NBA Twitter, internet culture) and writes
# 10-15 one-line references into BRIEF_FILE, which is added to the bot's prompt while
# fresh (3 days). No chat content is sent. Editable in the dashboard.
BRIEF_ENABLED=false
BRIEF_TIME=08:00
BRIEF_TOPICS=
BRIEF_FILE=
BRIEF_MAX_BUDGET_USD=0.50

# ----- Dashboard -------------------------------------------------------------
# http://127.0.0.1:PORT/dashboard on this Mac only: status, what the bot can see
# and connect to, memory notes (editable), reminders, live event feed.
DASHBOARD_ENABLED=false

# ----- Logging ---------------------------------------------------------------
# Logs contain event type, chat GUID, timestamps, durations, error class names.
# They never contain message text, prompts, sender addresses, or secrets.
LOG_LEVEL=INFO
